# 内容生成配置
content:
  # 主题列表
  topics:
    - "秋冬穿搭"
    - "美妆教程"
    - "美食分享"
    - "旅行攻略"
    - "健身打卡"
    - "读书笔记"

# AI配置（选择一个使用）
ai:
  # 阿里云百炼平台配置（推荐）
  bailian:
    api_key: "your-bailian-api-key-here"
    # 百炼支持的模型列表
    # 通义千问系列:
    #   - qwen3-max-2026-01-23: 最新最强
    #   - qwen3.7-plus: 推荐，平衡性能与成本 ⭐
    #   - qwen3.6-plus: 稳定版本
    #   - qwen3.5-plus: 经济版本
    #   - qwen3-coder-plus: 代码优化版本
    #   - qwen3-coder-next: 代码增强版本
    # 其他大模型:
    #   - kimi-k2.5: 月之暗面Kimi
    #   - glm-5: 智谱AI最新版
    #   - glm-4.7: 智谱AI稳定版
    #   - MiniMax-M2.5: MiniMax
    model: "qwen3.7-plus"
    max_tokens: 2000
    # 百炼API地址
    base_url: "https://coding.dashscope.aliyuncs.com/apps/anthropic"

  # Anthropic Claude配置
  claude:
    api_key: "your-claude-api-key-here"
    model: "claude-sonnet-4-6"
    max_tokens: 2000

  # OpenAI配置
  openai:
    api_key: "your-openai-api-key-here"
    model: "gpt-4"
    max_tokens: 2000

# 图片生成配置
image:
  # 图片来源：ai_generate（AI生成）| local_library（本地素材库）| unsplash
  source: "local_library"

  # 本地素材库路径（如果source为local_library）
  local_library_path: "./data/images"

  # AI生图配置（如果source为ai_generate）
  ai_generate:
    provider: "dalle"  # dalle | stable_diffusion
    size: "1024x1024"

# 数据库配置
database:
  path: "./data/drafts.db"

# 发布配置
publish:
  # 默认发布平台
  platform: "xiaohongshu"

  # 发布间隔（秒）
  interval: 300

  # 每日最大发布数量
  daily_limit: 3